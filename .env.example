# Copy to .env and fill in. .env is gitignored and Claude Code is denied read access to it
# (NFR-SEC-01: secrets in environment variables or CI secrets, never in the repository).
#
# These names match the repository secrets and variables already set on GitHub, so a value
# means the same thing locally and in Actions. Secrets: FORMAL_ENGINE_GEMINI,
# LANGFUSE_SECRET_KEY. Variables: LANGFUSE_PUBLIC_KEY, LANGFUSE_BASE_URL.
#
# CI itself needs none of them: it runs in replay mode against tests/fixtures/llm_cache/
# and never reaches a model. They are here for Tom's record and live runs.

# Inference and judgement (ADR-0003): Google AI Studio key for gemini-2.5-flash.
# Deliberately not named GOOGLE_API_KEY or GEMINI_API_KEY. The Google SDK reads those two
# from the ambient environment on its own, so a shell that happened to have one set could
# reach a live model without the run being in live mode. engine.llm reads this name only.
FORMAL_ENGINE_GEMINI=

# Evaluation traces (spec section 2). Leave blank to run without Langfuse.
# These are the Langfuse SDK's own names, so the SDK will pick them up from the ambient
# environment. That is fine here: the worst case is a trace written to the wrong project,
# not a paid model call. Do not follow this pattern for a provider key.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# replay (default, no network) | record | live.
# Anything other than replay also needs the live-run allow flag set in the process
# environment; that flag is Tom's to set and the Bash guard blocks Claude from setting it.
ENGINE_LLM_MODE=replay
